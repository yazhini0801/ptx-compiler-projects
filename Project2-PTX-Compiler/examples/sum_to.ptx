.version 7.8
.target sm_75
.address_size 64

.visible .entry sum_to(
    .param .u64 sum_to_param_0,
    .param .u32 sum_to_param_1
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<14>;
    .reg .b64 %rd<5>;
    ld.param.u64 %rd2, [sum_to_param_0];
    cvta.to.global.u64 %rd1, %rd2;
    ld.param.u32 %r1, [sum_to_param_1];
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mov.u32 %r5, %tid.x;
    mad.lo.s32 %r6, %r3, %r4, %r5;
    mov.b32 %r2, %r6;
    setp.lt.s32 %p1, %r2, %r1;
    @!%p1 bra L_end1;
    mov.s32 %r8, 0;
    mov.b32 %r7, %r8;
    mov.s32 %r10, 0;
    mov.b32 %r9, %r10;
L_cond2:
    setp.lt.s32 %p2, %r9, %r1;
    @!%p2 bra L_end2;
    add.s32 %r11, %r7, %r9;
    mov.b32 %r7, %r11;
    mov.s32 %r12, 1;
    add.s32 %r13, %r9, %r12;
    mov.b32 %r9, %r13;
    bra L_cond2;
L_end2:
    mul.wide.s32 %rd3, %r2, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.s32 [%rd4], %r7;
L_end1:
    ret;
}

