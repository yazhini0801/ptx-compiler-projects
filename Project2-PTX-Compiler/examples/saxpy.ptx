.version 7.8
.target sm_75
.address_size 64

.visible .entry saxpy(
    .param .u64 saxpy_param_0,
    .param .u64 saxpy_param_1,
    .param .f32 saxpy_param_2,
    .param .u32 saxpy_param_3
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<7>;
    .reg .f32 %f<6>;
    .reg .b64 %rd<11>;
    ld.param.u64 %rd3, [saxpy_param_0];
    cvta.to.global.u64 %rd1, %rd3;
    ld.param.u64 %rd4, [saxpy_param_1];
    cvta.to.global.u64 %rd2, %rd4;
    ld.param.f32 %f1, [saxpy_param_2];
    ld.param.u32 %r1, [saxpy_param_3];
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mov.u32 %r5, %tid.x;
    mad.lo.s32 %r6, %r3, %r4, %r5;
    mov.b32 %r2, %r6;
    setp.lt.s32 %p1, %r2, %r1;
    @!%p1 bra L_end1;
    mul.wide.s32 %rd6, %r2, 4;
    add.s64 %rd5, %rd1, %rd6;
    ld.global.f32 %f2, [%rd5];
    mul.f32 %f3, %f1, %f2;
    mul.wide.s32 %rd8, %r2, 4;
    add.s64 %rd7, %rd2, %rd8;
    ld.global.f32 %f4, [%rd7];
    add.f32 %f5, %f3, %f4;
    mul.wide.s32 %rd9, %r2, 4;
    add.s64 %rd10, %rd2, %rd9;
    st.global.f32 [%rd10], %f5;
L_end1:
    ret;
}

